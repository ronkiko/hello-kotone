{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Character Asset Normalization Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "character_model_id", "animation_id", "source_body_height_px", "frames"],
  "properties": {
    "schema": {"const": 1},
    "character_model_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "animation_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "source_body_height_px": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "One common anatomical source scale for this animation. Never vary scale per frame."
    },
    "source_cleanup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transparent_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "fuzz_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 25
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": {"type": "string"},
        "method": {"enum": ["human", "llm", "human_reviewed_llm"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "notes": {"type": "string"}
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "source_root_px"],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^\\d{3}\\.png$"
          },
          "source_root_px": {
            "type": "array",
            "prefixItems": [{"type": "number"}, {"type": "number"}],
            "minItems": 2,
            "maxItems": 2,
            "description": "Ground-contact center in source-frame pixel coordinates."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {"type": "string"}
        }
      }
    }
  }
}
