{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atomic frame placement plan v1 (7.11)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_root_px",
    "source_body_height_px",
    "analysis"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "source_root_px": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "source_body_height_px": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "confidence"
      ],
      "properties": {
        "method": {
          "enum": [
            "llm",
            "human",
            "llm_reviewed_heuristic",
            "human_reviewed_heuristic"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": "string"
        },
        "author": {
          "type": "string"
        }
      }
    }
  }
}
